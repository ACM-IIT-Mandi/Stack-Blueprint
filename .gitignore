# Root .gitignore
# Each blueprint has its OWN .gitignore covering its language and tooling.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
credentials.json

# Toolings
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs and caches
*.log
.cache/
